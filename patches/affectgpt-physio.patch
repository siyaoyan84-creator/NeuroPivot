     # ===================================================== #
     # 为 EVA_CLIP 保留每个图片的 32 tokens
     # 其他 visual encoder 默认是 1 tokens
+        # =====================================================
+        # Gate4 physiology branch:
+        # explicit [Valence, Arousal] -> one Qwen soft token.
+        #
+        # Kept independent from AffectGPT's pretrained
+        # audio/video fusion.
+        # =====================================================
+        self.num_physio_query_token = 1
+
+        self.physio_projector = nn.Sequential(
+            nn.Linear(2, 128),
+            nn.GELU(),
+            nn.Linear(
+                128,
+                self.llama_model.config.hidden_size,
+            ),
+        )
+
+
+    def encode_physio(self, physio_va):
+        """
+        physio_va:
+            [2] or [B, 2], ordered as [Valence, Arousal]
+
+        returns:
+            [B, 1, Qwen_hidden]
+        """
+        if physio_va.dim() == 1:
+            physio_va = physio_va.unsqueeze(0)
+
+        proj_ref = self.physio_projector[0].weight
+
+        physio_va = physio_va.to(
+            device=proj_ref.device,
+            dtype=proj_ref.dtype,
+        )
+
+        physio_llms = self.physio_projector(
+            physio_va
+        )
+
+        # Qwen was loaded in fp16. Its ordinary token
+        # embeddings and our soft token must have the same
+        # dtype/device before concatenation.
+        llm_ref = (
+            self.llama_model
+            .model.model
+            .embed_tokens.weight
+        )
+
+        physio_llms = physio_llms.to(
+            device=llm_ref.device,
+            dtype=llm_ref.dtype,
+        )
+
+        return physio_llms.unsqueeze(1)
+
+
+    def freeze_all_except_physio(self):
+        """
+        Gate4-B protocol:
+        freeze every original AffectGPT parameter and
+        train only PhysioProjector.
+        """
+        for param in self.parameters():
+            param.requires_grad = False
+
+        for param in self.physio_projector.parameters():
+            param.requires_grad = True
+
+
